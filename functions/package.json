{
  "name": "mathquest-functions",
  "private": true,
  "description": "MathQuest STEAM game-builder agent (Cloud Functions, 2nd gen callable)",
  "main": "index.js",
  "engines": { "node": "24" },
  "scripts": {
    "test:unit": "node --test test/unit.test.js",
    "test:handler": "firebase emulators:exec --only auth,firestore --project demo-mathquest \"node --test test/handler.test.js\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore,functions --project demo-mathquest \"node --test test/e2e.test.js\""
  },
  "dependencies": {
    "@google/genai": "3.0.0",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "firebase": "13.2.0",
    "jsdom": "31.0.0"
  }
}
