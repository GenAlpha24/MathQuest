{
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json", "firestore.*", "*.log", "*.md", "*.pdf", ".*", "**/.*",
      "functions/**", "rules-test/**", "deploy/**", ".agents/**", ".kiro/**", ".git/**",
      "node_modules/**", "**/node_modules/**",
      "index-Crayon-version.html", "index-Original.html"
    ]
  },
  "functions": [{
    "source": "functions",
    "codebase": "default",
    "disallowLegacyRuntimeConfig": true,
    "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local", "test"]
  }],
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
